{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCT",
  "version": "0.8.0",
  "identifier": "com.eliostruyf.github-copilot-usage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GCT",
        "width": 446,
        "height": 136,
        "center": true,
        "resizable": true,
        "minWidth": 260,
        "minHeight": 76,
        "maxWidth": 900,
        "maxHeight": 900,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "tray-icon-light.png",
      "showMenuOnLeftClick": false,
      "tooltip": "GCT"
    },
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}